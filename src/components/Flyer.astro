---
import type { PortalEvent } from "../lib/content";

interface Props {
  event: PortalEvent;
}
const { event } = Astro.props;
---
{event.uploadedFlyer ? (
  <img class="uploaded-flyer" src={event.cover} alt={`Flyer de ${event.name}`} loading="lazy"/>
) : (
<div class="flyer" style={`--flyer-color:${event.color}`}>
  <img src={event.cover} alt="" loading="lazy"/>
  <span class="flyer-status">Em breve</span>
  <div class="flyer-title">
    <strong>{event.headline}</strong>
    <small>{event.edition}</small>
  </div>
</div>
)}

<style>
  .uploaded-flyer {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    background: var(--surface);
    border-radius: .7rem .7rem 0 0;
  }
  :global(.event-card:hover .flyer-button) .uploaded-flyer,
  :global(.flyer-button:focus-visible) .uploaded-flyer {
    transform: none;
  }
  :global(dialog) .uploaded-flyer {
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: .65rem;
  }
</style>
