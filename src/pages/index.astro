---
import "@fontsource/chakra-petch/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "../styles/global.css";
import Brand from "../components/Brand.astro";
import Flyer from "../components/Flyer.astro";
import { links, events, djs, sets, gallery, bookingEmail, developerCredit } from "../data/portal";
// Preencha com os endereços oficiais do coletivo.
const socialLinks: { name: string; url?: string; icon: string }[] = [
  { name: "Instagram", url: "", icon: "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm8 9a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm1.5-5.5h.01" },
  { name: "TikTok", url: "", icon: "M14 4v12a4 4 0 1 1-4-4m4-8c0 3 2 5 5 5" },
  { name: "SoundCloud", url: "", icon: "M3 10v4m3-7v10m3-13v16m3-15v14m3-11v8m3-6v4m3-3v2" },
  { name: "YouTube", url: "", icon: "M3 9a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3Zm7 0 5 3-5 3Z" },
];
const categories = ['Todas', ...new Set(gallery.map(photo => photo.category))];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="SunRisepvt, coletivo de quatro DJs. Confira agenda, flyers, sets e contatos para contratação."/>
  <meta name="theme-color" content="#0b0813"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <title>SunRisepvt | Onde a noite se encontra com o amanhecer</title>
</head>
<body id="inicio">
  <a class="skip" href="#principal">Ir para o conteúdo</a>
  <header class="header">
    <div class="shell nav">
      <Brand id="header"/>
      <button class="menu" type="button" aria-controls="nav-links" aria-expanded="false" hidden>Menu <span aria-hidden="true">☰</span></button>
      <nav id="nav-links" aria-label="Navegação principal">
        {links.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <a class="button primary nav-cta" href="#agenda">Próxima festa <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
    </div>
  </header>
  <main id="principal">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/media/stage.webp" alt="" fetchpriority="high"/>
      <div class="shell hero-content">
        <p class="eyebrow hero-label"><i></i> EDM · TRANCE · PSYTRANCE <span>/</span> EXPERIÊNCIAS PVT</p>
        <h1 id="hero-title">Onde a noite<br/> se encontra com<br/> <em>o amanhecer.</em></h1>
        <p class="intro">Quatro amigos, quatro DJs. Música eletrônica e festas que atravessam a noite até as primeiras luzes.</p>
        <div class="actions">
          <a class="button primary" href="#agenda">Ver agenda e flyers <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
          <a class="button secondary" href="#sets"><span aria-hidden="true">▷</span> Ouvir sets</a>
        </div>
        <ul class="hero-details">
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/><circle cx="9" cy="7" r="4"/></svg>
            4 DJs, uma conexão
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Festas e encontros PVT
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 10v4m4-7v10m4-14v18m4-16v14m4-11v8m4-6v4"/></svg>
            Até o amanhecer
          </li>
        </ul>
      </div>
      <a class="hero-scroll" href="#agenda">A pista é o nosso ponto de encontro <span aria-hidden="true">⌄</span></a>
    </section>
    <div class="genres" aria-label="Estilos musicais"><div class="shell"><span>EDM</span><span>TRANCE</span><span>PSYTRANCE</span><span>PROGRESSIVE</span><span>EXPERIÊNCIAS PVT</span><span>ATÉ O AMANHECER</span></div></div>

    <section class="shell section" id="agenda" aria-labelledby="agenda-title">
      <p class="eyebrow">Agenda</p>
      <h2 id="agenda-title">A noite nos espera.</h2>
      <p class="section-intro">As próximas datas e locais serão divulgados pelo coletivo. Veja abaixo os flyers conceituais desta prévia.</p>
      <div class="event-grid" id="flyers">
        {events.map((event, index) => (
          <article class="card event-card">
            <button class="flyer-button" type="button" data-dialog={`flyer-${index}`} aria-label={`Ampliar flyer de ${event.name}`}>
              <Flyer event={event}/>
            </button>
            <div class="card-body">
              <h3>{event.name}</h3>
              <p class="event-genre">{event.genre}</p>
              <p>{event.description}</p>
              <button class="text-button" type="button" data-dialog={`flyer-${index}`}>Ver flyer <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13 13 3M5 3h8v8"/></svg></button>
            </div>
            <dialog id={`flyer-${index}`} aria-label={event.name}>
              <form method="dialog"><button class="button secondary close" aria-label="Fechar flyer">×</button></form>
              <Flyer event={event}/>
              <p class="dialog-caption">Flyer conceitual · Data, local e line-up a confirmar.</p>
            </dialog>
          </article>
        ))}
      </div>
    </section>

    <section class="band" id="djs" aria-labelledby="djs-title">
      <div class="shell section">
        <p class="eyebrow">O coletivo</p><h2 id="djs-title">4 amigos. Uma frequência.</h2>
        <p class="section-intro">O SunRisepvt nasceu da amizade de quatro DJs e da vontade de criar festas onde EDM, Trance e Psytrance dividem a mesma pista.</p>
        <div class="dj-grid">
          {djs.map((dj,index) => <article class="dj">
            <div class="dj-portrait"><img src={`/media/dj-${index+1}.webp`} alt="" loading="lazy"/></div>
            <div class="card-body"><h3>{dj.name}</h3><p>{dj.genre}</p></div>
          </article>)}
        </div>
        <p class="note">Nomes artísticos e retratos ilustrativos nesta prévia.</p>
      </div>
    </section>

    <section class="shell section" id="sets" aria-labelledby="sets-title">
      <p class="eyebrow">Sets</p><h2 id="sets-title">Dê play na sua próxima viagem.</h2>
      <div class="set-grid">
        <div class="set-list" aria-label="Selecione um set">
          {sets.map((set,index) => <button type="button" class="set-button" data-set={index} aria-controls={`set-${index}`} aria-pressed={index===0}><span class="set-cover"><img src={set.cover} alt="" loading="lazy"/><span class="set-play" aria-hidden="true">▷</span></span>
            <span class="set-info"><strong>{set.title}</strong><small>{set.dj} · {set.style}</small></span></button>)}
        </div>
        {sets.map((set,index) => <article class="card set-panel" id={`set-${index}`} hidden={index!==0}>
          <div class="now-playing"><h3>{set.title}</h3><p>{set.dj} · {set.style}</p></div>
          <div class="waveform" aria-hidden="true">
            {Array.from({ length: 96 }, (_, bar) => <i style={`--bar-height:${20 + ((bar * 17) % 75)}%`}></i>)}
          </div>
          {set.embed ? <iframe title={`Player de ${set.title}`} src={set.embed} loading="lazy" allow="autoplay; encrypted-media"></iframe> : <p class="note">Áudio ainda indisponível nesta prévia.</p>}
        </article>)}
      </div>
    </section>

    <section class="band" id="galeria" aria-labelledby="gallery-title">
      <div class="shell section">
        <p class="eyebrow">Galeria</p><h2 id="gallery-title">Você tinha que estar lá.</h2>
        <p class="section-intro">Imagens conceituais da pista, do amanhecer e dos bastidores.</p>
        <div class="filters" aria-label="Filtrar galeria">
          {categories.map((category,index) => <button type="button" class="chip" data-filter={category} aria-pressed={index===0}>{category}</button>)}
        </div>
        <div class="gallery-grid" id="gallery-results">
          {gallery.map((photo,index) => <figure data-category={photo.category}>
            <button type="button" data-dialog={`photo-${index}`} aria-label={`Ampliar: ${photo.title}`}><img src={photo.src} alt="" loading="lazy"/><span>{photo.title}</span></button>
            <dialog id={`photo-${index}`} aria-label={photo.title}>
              <form method="dialog"><button class="button secondary close" aria-label="Fechar foto">×</button></form>
              <img src={photo.src} alt={photo.title} loading="lazy"/><p class="dialog-caption">{photo.title}</p>
            </dialog>
          </figure>)}
        </div>
      </div>
    </section>

    <section class="shell section booking" id="contratar" aria-labelledby="booking-title">
      <div><p class="eyebrow">Contratação</p><h2 id="booking-title">A sua festa.<br/><em>A nossa frequência.</em></h2>
      <p class="section-intro">Do set individual à experiência completa. Levamos a energia da SunRisepvt para o seu evento.</p>
      <ul class="booking-options">
        <li>DJ set individual</li>
        <li>Line-up completo com os 4 DJs</li>
        <li>Produção e parceria de festas</li>
      </ul>
      <p class="note" id="booking-help">{bookingEmail ? 'O formulário abre um rascunho no seu aplicativo de e-mail.' : 'Formulário demonstrativo. Use dados fictícios.'}</p>
      </div>
      <form class="card booking-form" id="booking" data-email={bookingEmail} aria-describedby="booking-help">
        <label>Nome ou produtora<input name="nome" placeholder="Como podemos te chamar?" autocomplete="name" required maxlength="120"/></label>
        <label>E-mail ou WhatsApp<input name="contato" placeholder="Seu melhor contato" required maxlength="120"/></label>
        <div class="form-grid">
          <label>Data prevista<input name="data" type="date" required/></label>
          <label>Estilo musical<select name="estilo"><option>Misto</option><option>EDM</option><option>Trance</option><option>Psytrance</option></select></label>
        </div>
        <label>Tipo de contratação<select name="tipo"><option>DJ set individual</option><option>Line-up completo (4 DJs)</option><option>Produção ou parceria</option></select></label>
        <label>Mensagem<textarea name="mensagem" rows="4" maxlength="2000" required></textarea></label>
        <button type="submit" disabled class="button primary">{bookingEmail ? 'Preparar e-mail' : 'Simular proposta'} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13 13 3M5 3h8v8"/></svg></button>
        <p class="note" role="status"></p>
      </form>
    </section>
  </main>
  <footer class="footer">
    <div class="shell">
      <div class="footer-content">
        <div>
          <Brand id="footer"/>
          <p>Onde a noite se encontra com o amanhecer.</p>
        </div>
        <nav aria-label="Rodapé">{links.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav>
        <ul class="footer-socials" aria-label="Redes sociais">
          {socialLinks.map(({name, url, icon}) => {
            const IconTag = url ? "a" : "span";
            return (
              <li>
                <IconTag href={url} class="social-icon" aria-label={url ? name : undefined} title={url ? name : `${name} · link em breve`}>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d={icon}/>
                  </svg>
                  {!url && <span class="sr-only">{name} · link em breve</span>}
                </IconTag>
              </li>
            );
          })}
        </ul>
      </div>
      <div class="footer-bottom">
        <small>© {new Date().getFullYear()} SunRisepvt. Todos os direitos reservados.</small>
        <div class="developer-credit">
          <span>Desenvolvido por</span>
          {developerCredit.url ? (
            <a href={developerCredit.url}>
              {developerCredit.logo ? <img src={developerCredit.logo} alt={developerCredit.name} loading="lazy"/> : developerCredit.name}
            </a>
          ) : developerCredit.logo ? <img src={developerCredit.logo} alt={developerCredit.name} loading="lazy"/> : <strong>{developerCredit.name}</strong>}
        </div>
      </div>
    </div>
  </footer>
</body>
</html>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  const nav = document.getElementById('nav-links');
  if (menu && nav) {
    menu.hidden = false;
    nav.classList.add('enhanced');
    const closeMenu = () => menu.setAttribute('aria-expanded', 'false');
    menu.addEventListener('click', () => menu.setAttribute('aria-expanded', String(menu.getAttribute('aria-expanded') !== 'true')));
    nav.addEventListener('click', closeMenu);
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        menu.focus();
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-dialog]').forEach(button => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.dialog ?? '');
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const photos = document.querySelectorAll<HTMLElement>('[data-category]');
  filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
    photos.forEach(photo => {
      photo.hidden = button.dataset.filter !== 'Todas' && photo.dataset.category !== button.dataset.filter;
    });
  }));

  const choices = document.querySelectorAll<HTMLButtonElement>('[data-set]');
  choices.forEach(button => button.addEventListener('click', () => {
    choices.forEach(choice => {
      const active = choice === button;
      choice.setAttribute('aria-pressed', String(active));
      const panel = document.getElementById(choice.getAttribute('aria-controls') ?? '');
      if (panel) {
        panel.hidden = !active;
        const player = panel.querySelector('iframe');
        if (!active && player) player.src = player.src;
      }
    });
  }));

  const booking = document.querySelector<HTMLFormElement>('#booking');
  booking?.querySelector<HTMLButtonElement>('button[type=submit]')?.removeAttribute('disabled');
  booking?.addEventListener('submit', event => {
    event.preventDefault();
    const status = booking.querySelector('[role="status"]');
    const email = booking.dataset.email;
    if (!email) {
      if (status) status.textContent = 'Prévia concluída. Nenhuma mensagem foi enviada.';
      return;
    }
    const data = new FormData(booking);
    const body = [...data].map(([label, value]) => `${label}: ${value}`).join('\n');
    if (status) status.textContent = 'Rascunho preparado para envio no seu aplicativo de e-mail.';
    window.location.href = `mailto:${email}?subject=${encodeURIComponent('Contratação SunRisepvt')}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .hero-details li {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
  }
  .hero-details svg {
    flex: none;
    width: .9rem;
    height: .9rem;
    fill: none;
    stroke: var(--orange);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .footer-socials {
    display: flex;
    align-items: center;
    gap: .25rem;
  }
  .social-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .4rem;
    color: #f3f4f6;
  }
  .social-icon svg { width: 1rem; height: 1rem; }
  a.social-icon:hover, a.social-icon:focus-visible { color: var(--orange); }
  .developer-credit img { max-width: 5rem; max-height: 1.125rem; }
  @media (max-width: 42rem) {
    .footer-content { flex-direction: column; align-items: flex-start; }
  }
</style>
